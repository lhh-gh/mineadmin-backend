# Docker Compose reads this file as raw environment values (Compose >= 2.30).
# Do not wrap values in quotes; $ and # inside values are literal.
APP_NAME=MineAdmin
APP_ENV=prod
APP_DEBUG=false
APP_URL=https://api.example.com
HTTP_HOST=0.0.0.0
HTTP_PORT=9501
SWOOLE_WORKER_NUM=1
SWAGGER_ENABLED=false
SWAGGER_AUTO_GENERATE=false
MINE_PLUGIN_UPLOAD_ENABLED=false

DB_DRIVER=mysql
# Use the independent Aliyun service endpoint reachable from the app server.
DB_HOST=CHANGE_ME_ALIYUN_MYSQL_HOST
DB_PORT=3306
DB_DATABASE=mineadmin
DB_USERNAME=mineadmin
DB_PASSWORD=CHANGE_ME_MYSQL_APP_PASSWORD
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=
DB_MAX_IDLE_TIME=60

REDIS_HOST=CHANGE_ME_ALIYUN_REDIS_HOST
REDIS_PORT=6379
REDIS_AUTH=CHANGE_ME_REDIS_PASSWORD
REDIS_DB=0
REDIS_MAX_IDLE_TIME=60

JWT_SECRET=CHANGE_ME_GENERATE_A_NEW_RANDOM_SECRET
MINE_ACCESS_TOKEN=
HEALTHCHECK_DEPENDENCIES=true
