# Local app container on Docker Desktop; Windows FlyEnv runs MySQL/Redis.
# docker run --env-file reads literal values: do not wrap values in quotes.
APP_NAME=MineAdmin
APP_ENV=dev
APP_DEBUG=false
APP_URL=http://127.0.0.1:19501
HTTP_HOST=0.0.0.0
HTTP_PORT=9501
SWOOLE_WORKER_NUM=1
SWAGGER_ENABLED=false
SWAGGER_AUTO_GENERATE=false
MINE_PLUGIN_UPLOAD_ENABLED=false

# Docker Desktop resolves host.docker.internal to Windows.
# With a separate WSL Docker Engine, replace with the Windows IP reachable from WSL.
DB_DRIVER=mysql
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=mineadmin_local
DB_USERNAME=mineadmin_local
DB_PASSWORD=CHANGE_ME_LOCAL_MYSQL_PASSWORD
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=

REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_AUTH=CHANGE_ME_LOCAL_REDIS_PASSWORD
REDIS_DB=1
JWT_SECRET=CHANGE_ME_GENERATE_A_LOCAL_RANDOM_SECRET
HEALTHCHECK_DEPENDENCIES=true
