# Keep the production build context limited to backend source and runtime assets.
**
!composer.json
!composer.lock
!LICENSE
!app/
!app/**
!bin/
!bin/**
!config/
!config/**
!databases/
!databases/**
!kernel/
!kernel/**
!plugin/
!plugin/**
!storage/
!storage/index.html
!storage/languages/
!storage/languages/**
!storage/swagger/
!storage/swagger/index.html
!deploy/
!deploy/entrypoint.sh
!deploy/healthcheck.php

# Exclude local secrets and generated artifacts even inside an allowed directory.
**/.env
**/.env.*
**/auth.json
**/*.key
**/*.pem
**/*.p12
**/*.log
**/.git
**/.git/**
**/vendor/**
**/node_modules/**
**/runtime/**
**/tests/**
**/test/**
**/.DS_Store
